{
  "manifest_version": 3,
  "name": "Search Shortcut",
  "version": "1.0.0",
  "description": "Press Ctrl+M on YouTube, GitHub, Google Keep to jump to the search bar.",
  "content_scripts": [
    {
      "matches": [
        "https://www.youtube.com/*",
        "https://github.com/*",
        "https://keep.google.com/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}